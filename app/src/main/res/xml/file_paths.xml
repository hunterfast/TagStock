<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Artikelfotos liegen im privaten App-Verzeichnis; die Kamera-App
         bekommt ueber den FileProvider nur auf diesen Ordner Zugriff. -->
    <files-path
        name="fotos"
        path="fotos/" />

    <!-- Heruntergeladene App-Fassungen: nur diesen Ordner sieht die
         Installationsanwendung, sonst nichts. -->
    <files-path
        name="app-fassungen"
        path="fassungen/" />

    <!-- Sicherungen vor einem Wechsel der Fassung - zum Weitergeben. -->
    <external-files-path
        name="sicherungen"
        path="sicherungen/" />
</paths>
