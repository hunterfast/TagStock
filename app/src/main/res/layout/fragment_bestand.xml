<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Zahlen -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGesamt"
                style="@style/Widget.TagStock.Zahlenkarte"
                android:layout_width="0dp"
                android:layout_weight="1">

                <LinearLayout style="@style/Widget.TagStock.Zahlenkarte.Inhalt">

                    <TextView
                        android:id="@+id/textGesamt"
                        style="@style/Widget.TagStock.Zahl"
                        tools:text="24" />

                    <TextView
                        style="@style/Widget.TagStock.Zahlenkarte.Label"
                        android:text="@string/stats_gesamt" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardVorhanden"
                style="@style/Widget.TagStock.Zahlenkarte"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1">

                <LinearLayout style="@style/Widget.TagStock.Zahlenkarte.Inhalt">

                    <TextView
                        android:id="@+id/textVorhanden"
                        style="@style/Widget.TagStock.Zahl"
                        android:textColor="@color/status_vorhanden"
                        tools:text="18" />

                    <TextView
                        style="@style/Widget.TagStock.Zahlenkarte.Label"
                        android:text="@string/status_vorhanden" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFehlt"
                style="@style/Widget.TagStock.Zahlenkarte"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1">

                <LinearLayout style="@style/Widget.TagStock.Zahlenkarte.Inhalt">

                    <TextView
                        android:id="@+id/textFehlt"
                        style="@style/Widget.TagStock.Zahl"
                        android:textColor="@color/status_fehlt"
                        tools:text="2" />

                    <TextView
                        style="@style/Widget.TagStock.Zahlenkarte.Label"
                        android:text="@string/stats_fehlt" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardVerliehen"
                style="@style/Widget.TagStock.Zahlenkarte"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1">

                <LinearLayout style="@style/Widget.TagStock.Zahlenkarte.Inhalt">

                    <TextView
                        android:id="@+id/textVerliehen"
                        style="@style/Widget.TagStock.Zahl"
                        android:textColor="@color/status_verliehen"
                        tools:text="4" />

                    <TextView
                        style="@style/Widget.TagStock.Zahlenkarte.Label"
                        android:text="@string/status_verliehen" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Warnungen -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardUeberfaellig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/warnung_hintergrund"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/warnung_rand"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_warnung"
                        app:tint="@color/warnung_text" />

                    <TextView
                        android:id="@+id/textUeberfaelligTitel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="@color/warnung_text"
                        tools:text="2 Artikel überfällig" />

                    <ImageButton
                        android:id="@+id/buttonUeberfaelligAusklappen"
                        style="@style/Widget.TagStock.IconButton"
                        android:contentDescription="@string/action_ausklappen"
                        android:src="@drawable/ic_chevron_unten" />

                    <ImageButton
                        android:id="@+id/buttonUeberfaelligSchliessen"
                        style="@style/Widget.TagStock.IconButton"
                        android:contentDescription="@string/action_schliessen"
                        android:src="@drawable/ic_close" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/containerUeberfaellig"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardVermisst"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/vermisst_hintergrund"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/vermisst_rand"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:id="@+id/headerVermisst"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_warnung"
                        app:tint="@color/vermisst_text" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textVermisstTitel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textColor="@color/vermisst_text"
                            tools:text="3 Artikel lange nicht gescannt" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/banner_vermisst_hinweis"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/vermisst_text" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_unten"
                        app:tint="@color/vermisst_text" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/containerVermisst"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Suche und Filter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/bestand_suche_hint"
                app:startIconDrawable="@drawable/ic_search">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editSuche"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonScanSuche"
                style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/bestand_per_scan_suchen"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                app:icon="@drawable/ic_scan"
                app:iconPadding="0dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/filter_kategorie">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/dropdownKategorie"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:hint="@string/filter_standort">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/dropdownStandort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:visibility="gone"
            app:singleLine="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/textAnzahl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceBodySmall"
                tools:text="24 Artikel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonAuswahl"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bestand_auswaehlen" />
        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerArtikel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="88dp" />

                <LinearLayout
                    android:id="@+id/leerAnsicht"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="32dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:alpha="0.3"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_artikel" />

                    <TextView
                        android:id="@+id/textLeerTitel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/bestand_leer_titel"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <TextView
                        android:id="@+id/textLeerText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="@string/bestand_leer_text"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />
                </LinearLayout>
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <!-- Aktionsleiste der Mehrfachauswahl -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAktionen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorPrimary"
        app:cardCornerRadius="18dp"
        app:cardElevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/textAuswahlAnzahl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnPrimary"
                tools:text="3 ausgewählt" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonAuswahlStatus"
                style="@style/Widget.TagStock.AktionsButton"
                android:text="@string/bestand_status" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonAuswahlStandort"
                style="@style/Widget.TagStock.AktionsButton"
                android:text="@string/artikel_standort" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonAuswahlEtiketten"
                style="@style/Widget.TagStock.AktionsButton"
                android:contentDescription="@string/bestand_etiketten"
                app:icon="@drawable/ic_qr" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonAuswahlAbbrechen"
                style="@style/Widget.TagStock.AktionsButton"
                android:contentDescription="@string/action_cancel"
                app:icon="@drawable/ic_close" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
