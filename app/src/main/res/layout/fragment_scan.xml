<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonModusEinzel"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/scan_modus_einzel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonModusListe"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/scan_modus_liste" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonModusSchnell"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/scan_modus_schnell" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="3"
        android:background="@color/black">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:layout_width="240dp"
            android:layout_height="150dp"
            android:layout_gravity="center"
            android:background="@drawable/scan_frame" />

        <TextView
            android:id="@+id/textKeineKamera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/scan_kamera_verweigert"
            android:textColor="@color/white"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textHinweis"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_margin="10dp"
            android:background="@drawable/pill_background"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="@string/scan_hinweis_einzel"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/white" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonBlitz"
            style="@style/Widget.Material3.Button.TextButton.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/scan_licht"
            app:icon="@drawable/ic_flash" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonManuell"
            style="@style/Widget.Material3.Button.TextButton.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/scan_eingeben"
            app:icon="@drawable/ic_keyboard" />
    </LinearLayout>

    <!-- Sammelliste fuer Listen- und Schnellscan -->
    <LinearLayout
        android:id="@+id/bereichListe"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/textZaehlerGebucht"
                style="@style/Widget.TagStock.Zaehler"
                android:textColor="@color/status_vorhanden"
                tools:text="4" />

            <TextView
                android:id="@+id/textZaehlerBereits"
                style="@style/Widget.TagStock.Zaehler"
                android:textColor="@color/status_verliehen"
                tools:text="1" />

            <TextView
                android:id="@+id/textZaehlerUnbekannt"
                style="@style/Widget.TagStock.Zaehler"
                android:textColor="@color/brand_primary"
                tools:text="2" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                style="@style/Widget.TagStock.ZaehlerLabel"
                android:text="@string/scan_zaehler_gebucht" />

            <TextView
                style="@style/Widget.TagStock.ZaehlerLabel"
                android:text="@string/scan_zaehler_bereits" />

            <TextView
                style="@style/Widget.TagStock.ZaehlerLabel"
                android:text="@string/scan_zaehler_unbekannt" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerLog"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="4dp" />

            <TextView
                android:id="@+id/textListeLeer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="16dp"
                android:text="@string/scan_liste_leer"
                android:textAppearance="?attr/textAppearanceBodySmall" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonLeeren"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scan_liste_leeren" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonBuchen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scan_buchen" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
