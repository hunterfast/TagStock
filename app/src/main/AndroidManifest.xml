<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.NFC" />

    <!-- Kamera und NFC sind optional, damit die App auch auf Geraeten
         ohne NFC-Chip installiert werden kann. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TagStock">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.LagerDetailActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.ItemEditActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.SucheActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.ScannerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TagStock.Scanner" />

        <activity
            android:name=".ui.InventurActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TagStock.Scanner" />

        <activity
            android:name=".ui.InventurErgebnisActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <!-- Gibt der Kamera-App Schreibrecht auf genau ein Verzeichnis. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fotos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
